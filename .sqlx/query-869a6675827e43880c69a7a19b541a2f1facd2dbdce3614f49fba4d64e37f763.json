{
  "db_name": "PostgreSQL",
  "query": "SELECT\n            b.id,\n            b.brew_hash,\n            b.brew_datetime,\n            b.rating,\n            b.grind_setting,\n            b.coffee_grams,\n            b.water_grams,\n            b.water_temp_c,\n            b.brew_time_secs,\n            b.filter_paper,\n            b.notes,\n            b.review,\n            cb.bag_hash,\n            cb.roaster,\n            cb.origin_country,\n            cb.origin_region,\n            cb.variety,\n            cb.process,\n            cb.roast_level,\n            g.name  AS grinder_name,\n            br.name AS brewer_name\n           FROM brews b\n           LEFT JOIN coffee_bags cb ON b.coffee_bag_id = cb.id\n           LEFT JOIN grinders g     ON b.grinder_id    = g.id\n           LEFT JOIN brewers  br    ON b.brewer_id      = br.id\n           WHERE b.user_id = $1\n           ORDER BY b.brew_datetime DESC",
